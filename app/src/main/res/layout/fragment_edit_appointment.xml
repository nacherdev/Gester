<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?android:attr/windowBackground" >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Modificar Cita"
            android:textColor="@color/edit_titulo"
            android:textSize="26sp"
            android:fontFamily="sans-serif-black" />

        <TextView
            android:id="@+id/tvEditCliente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cargando cita..."
            android:textColor="@color/edit_subtitulo"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/edit_card_bg"
            android:layout_marginBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FECHA DE LA CITA"
                    android:textColor="@color/edit_subtitulo"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvEditFecha"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/input_background"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:text="Seleccionar Fecha"
                    android:textColor="@color/edit_text_input"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif"
                    android:layout_marginBottom="20dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HORA DISPONIBLE"
                    android:textColor="@color/edit_subtitulo"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="6dp" />

                <Spinner
                    android:id="@+id/spEditHora"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/input_background"
                    android:paddingHorizontal="12dp"
                    android:layout_marginBottom="20dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SERVICIO REQUERIDO"
                    android:textColor="@color/edit_subtitulo"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="6dp" />

                <Spinner
                    android:id="@+id/spEditServicio"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/input_background"
                    android:paddingHorizontal="12dp"
                    android:layout_marginBottom="8dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarCambios"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Guardar Cambios"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            app:backgroundTint="@color/edit_btn_guardar"
            app:cornerRadius="12dp"
            android:layout_marginBottom="12dp"
            app:elevation="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEliminarCita"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Cancelar Cita"
            android:textColor="@color/edit_btn_eliminar_text"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            app:backgroundTint="#00000000"
            app:strokeColor="@color/edit_btn_eliminar_stroke"
            app:strokeWidth="1dp"
            app:cornerRadius="12dp" />

    </LinearLayout>
</ScrollView>