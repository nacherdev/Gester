<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?android:attr/windowBackground"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nueva Cita"
            android:textColor="@color/texto_titulo_cita"
            android:textSize="26sp"
            android:fontFamily="sans-serif-black" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Completa el formulario para agendar una nueva cita"
            android:textColor="@color/texto_subtitulo_cita"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BUSCAR CLIENTE EXISTENTE"
            android:textColor="@color/texto_etiquetas_cita"
            android:textSize="12sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.05"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btnRecuperarUsuario"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:text="Buscar por DNI"
                android:textColor="#FFFFFF"
                android:backgroundTint="@color/btn_buscar_dni"
                android:fontFamily="sans-serif-medium"
                android:textSize="14sp"
                app:cornerRadius="10dp" />

            <EditText
                android:id="@+id/etDniBusqueda"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:hint="Introduce DNI para buscar..."
                android:textColor="?android:attr/textColorPrimary"
                android:textColorHint="?android:attr/textColorSecondary"
                android:inputType="text"
                android:background="@drawable/input_background"
                android:paddingHorizontal="16dp"
                android:textSize="15sp"
                android:fontFamily="sans-serif"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DATOS DEL CLIENTE"
            android:textColor="@color/texto_etiquetas_cita"
            android:textSize="12sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.05"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Nombre"
            android:textColor="?android:attr/textColorPrimary"
            android:textColorHint="?android:attr/textColorSecondary"
            android:inputType="textPersonName"
            android:background="@drawable/input_background"
            android:paddingHorizontal="16dp"
            android:textSize="15sp"
            android:fontFamily="sans-serif"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etApellidos"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Apellidos"
            android:textColor="?android:attr/textColorPrimary"
            android:textColorHint="?android:attr/textColorSecondary"
            android:inputType="textPersonName"
            android:background="@drawable/input_background"
            android:paddingHorizontal="16dp"
            android:textSize="15sp"
            android:fontFamily="sans-serif"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etDni"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="DNI"
            android:textColor="?android:attr/textColorPrimary"
            android:textColorHint="?android:attr/textColorSecondary"
            android:inputType="text"
            android:background="@drawable/input_background"
            android:paddingHorizontal="16dp"
            android:textSize="15sp"
            android:fontFamily="sans-serif"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btnSeleccionarNacimiento"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:text="F. Nacimiento"
                android:textColor="@color/texto_btn_nacimiento"
                android:backgroundTint="@color/btn_nacimiento"
                android:fontFamily="sans-serif-medium"
                android:textSize="14sp"
                app:cornerRadius="10dp" />

            <EditText
                android:id="@+id/etFechaNacimiento"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:hint="dd/mm/aaaa"
                android:textColor="?android:attr/textColorPrimary"
                android:textColorHint="?android:attr/textColorSecondary"
                android:inputType="none"
                android:focusable="false"
                android:clickable="false"
                android:background="@drawable/input_background"
                android:paddingHorizontal="16dp"
                android:textSize="15sp"
                android:fontFamily="sans-serif" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SELECCIÓN DE SERVICIO"
            android:textColor="@color/texto_etiquetas_cita"
            android:textSize="12sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.05"
            android:layout_marginBottom="8dp"/>

        <Spinner
            android:id="@+id/spinnerServicios"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/input_background"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AGENDAR FECHA Y HORA"
            android:textColor="@color/texto_etiquetas_cita"
            android:textSize="12sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.05"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnSeleccionarFecha"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:text="Elegir Fecha"
                android:textColor="#FFFFFF"
                android:backgroundTint="@color/btn_elegir_fecha"
                android:fontFamily="sans-serif-medium"
                android:textSize="14sp"
                app:cornerRadius="10dp" />

            <TextView
                android:id="@+id/tvFechaSeleccionada"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="Fecha no seleccionada"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical|end"
                android:paddingHorizontal="16dp" />
        </LinearLayout>

        <Spinner
            android:id="@+id/spinnerHoras"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/input_background"
            android:layout_marginBottom="32dp"/>

        <Button
            android:id="@+id/btnGuardarCita"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Registrar Cita"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/btn_registrar_cita"
            android:textSize="16sp"
            android:fontFamily="sans-serif-black"
            app:cornerRadius="12dp" />

    </LinearLayout>
</ScrollView>